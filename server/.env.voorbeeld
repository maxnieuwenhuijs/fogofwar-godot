# Fog of War backend: omgeving voor een draaiende server (F4.4a).
# Kopieer naar .env (staat in .gitignore; op de droplet schrijft
# tools/deploy/droplet-setup.sh hem met een gegenereerd wachtwoord).
# systemd leest hem via EnvironmentFile; lokaal: `$env:DB_URL = ...` per regel.

# Verplicht: MySQL-verbinding (gebruiker met alleen rechten op deze database).
DB_URL=mysql://fogofwar:GEHEIM@127.0.0.1:3306/fogofwar

# Luisteradres. Achter nginx ALTIJD 127.0.0.1; 0.0.0.0 alleen voor een LAN-playtest.
POORT=8787
HOST=127.0.0.1

# De Godot-binary (zelfde versie als de client: de core-hash bewaakt de engine,
# niet de Godot-versie) en het uitgeklede engine-pakket (bouw_serverpakket.ps1).
GODOT_PAD=/opt/fogofwar/godot/Godot_v4.7-stable_linux.x86_64
FOW_PROJECT_PAD=/opt/fogofwar/engine
