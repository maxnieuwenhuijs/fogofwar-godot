{
  "name": "fogofwar-server",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Fog of War online backend (F4.1): accounts, matches, event-log. Node 22 + Fastify; MySQL + Redis.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.1",
    "mysql2": "^3.11.4",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@testcontainers/mysql": "^10.16.0",
    "@types/node": "^22.10.2",
    "testcontainers": "^10.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
